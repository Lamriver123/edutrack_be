# Local development only. Use distinct secrets and HTTPS origins in production.
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/edutrack
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_COOKIE_NAME=edutrack_refresh_token
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAME_SITE=lax

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generate once: npx web-push generate-vapid-keys
# Keep the key pair stable across deploys. Never put PRIVATE_KEY in frontend env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Database Backup to Google Drive (2 AM daily, keeps 30 most recent)
# Service accounts require a real Google Workspace Shared Drive.
# Sharing a folder in personal My Drive is not sufficient for file uploads.
# Service Account key as single-line JSON string (escape newlines)
GOOGLE_SERVICE_ACCOUNT_KEY=
# For personal My Drive, use the owner's OAuth credentials instead.
# OAuth takes precedence when configured; all three values are required.
# The refresh token must grant https://www.googleapis.com/auth/drive.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# Folder ID from the Google Drive folder URL
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
# Max number of backup files to keep (default: 30)
BACKUP_MAX_COUNT=30
# Production defaults to true: catch up after startup if today's 2AM backup was missed.
# Development defaults to false.
BACKUP_CATCH_UP_ON_STARTUP=
